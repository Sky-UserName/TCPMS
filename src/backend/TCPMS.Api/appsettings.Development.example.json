{
  "Database": {
    "Provider": "InMemory"
  },
  "Urls": "http://0.0.0.0:5180",
  "Swagger": {
    "Enabled": true
  },
  "WeChat": {
    "MerchantPrivateKeyPath": "D:/path/to/apiclient_key.pem",
    "WeChatPayPublicKeyPath": "D:/path/to/pub_key.pem",
    "NotifyBaseUrl": "https://example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
